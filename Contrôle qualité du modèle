class Checks:

    @staticmethod
    def run(df):

        warnings = []

        if df["DSCR"].min() < 1.20:

            warnings.append(
                "DSCR inférieur à 1.20"
            )

        if df["LTV"].max() > 0.80:

            warnings.append(
                "LTV supérieur à 80%"
            )

        if abs(
                df["Solde Dette"].iloc[-1]
        ) > 1:

            warnings.append(
                "Dette non remboursée"
            )

        return warnings
