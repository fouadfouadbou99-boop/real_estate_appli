def run_checks(df):

    warnings = []

    if min(df["DSCR"]) < 1.20:
        warnings.append(
            "DSCR inférieur à 1.20"
        )

    if max(df["LTV"]) > 0.80:
        warnings.append(
            "LTV supérieur à 80%"
        )

    if df["Solde Dette"].iloc[-1] > 1:
        warnings.append(
            "Dette non remboursée"
        )

    return warnings
